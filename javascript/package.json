  "description": "Types-only authoring package for Stream Miner JavaScript parsers",
  "type": "module",
  "types": "./index.d.ts",
  "license": "UNLICENSED",
  "keywords": [
    "stream-miner",
    "parser-sdk",
    "typescript",
    "types"
  ],
  "homepage": "https://github.com/RidiculousCircumstances/stream-miner-authoring-sdk#readme",
